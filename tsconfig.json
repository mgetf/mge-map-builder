{
	"compilerOptions": {
		"target": "ESNext",
		"useDefineForClassFields": true,
		"module": "ESNext",
		"resolveJsonModule": true,
		"allowJs": true,
		"checkJs": true,
		"isolatedModules": true,
		"moduleDetection": "force",
		"noEmit": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"moduleResolution": "bundler",
		"paths": {
			"$lib": ["./src/mainview/lib"],
			"$lib/*": ["./src/mainview/lib/*"],
			"electrobun": ["./.hutch/devkit/api/sdks/main/index.ts"],
			"electrobun/main": ["./.hutch/devkit/api/sdks/main/index.ts"],
			"electrobun/bun": ["./.hutch/devkit/api/sdks/main/index.ts"],
			"electrobun/view": ["./.hutch/devkit/api/browser/index.ts"]
		}
	},
	"include": ["src", "electrobun.config.ts", "hutch.config.ts", "vite.config.ts"],
	"exclude": ["node_modules", "dist", "build", "../../package/dist"]
}
